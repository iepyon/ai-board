node_modules/
dist/
coverage/
*.log
.DS_Store

# 移行前のカードの正本（SQLite）。古いチェックアウトに残っていても共有しない。
# WAL / SHM（board.db-wal / -shm）と、退避したバックアップ（board.db.bak-… など）も含む
/.ai-board/board.db*

# ループが書く実行状態。共有しない
.ai-board/loop.json

# 廃止した GitLab 連携の名残（.env / バックアップと secrets）。手元に残っていても共有しない
.env
/gitlab-backup/

# 各自の GitHub 接続設定。config.example.yaml をコピーして使う
/.ai-board/config.yaml

# 各自の dev サーバ起動設定。launch.example.json をコピーして使う
/.claude/launch.json

# ループのサブエージェントがカードごとに作るワークツリー。中身はカードのブランチへコミットする
/.claude/worktrees/

# 起動中のサーバの場所（URL・pid）。サーバが起動時に書き、止まるときに消す
/.ai-board/server.json

# 共有のカードを置くデータ用ブランチ（ai-board/data）のワークツリーと、その隣に置く排他のロックと PR の状態の控え、
# 読み書きのモード（mode: local で手元モード）。
# データのワークツリーは ai-board の CLI とサーバが作り、コミットと push もそれらが行う
/.ai-board/data/
/.ai-board/cache/
/.ai-board/data.lock
/.ai-board/data-mode.yaml
