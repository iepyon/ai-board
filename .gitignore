node_modules/
dist/
coverage/
*.log
.DS_Store

# 各自の GitHub 接続設定。config.example.yaml をコピーして使う
/.ai-board/config.yaml

# ループのサブエージェントがカードごとに作るワークツリー。中身はカードのブランチへコミットする
/.claude/worktrees/

# 共有のカードを置くデータ用ブランチ（ai-board/data）のワークツリーと、その隣に置く排他のロックと PR の状態の控え、
# 読み書きのモード（mode: local で手元モード）。
# データのワークツリーは ai-board の CLI が作り、コミットと push も CLI が行う
/.ai-board/data/
/.ai-board/cache/
/.ai-board/data.lock
/.ai-board/data-mode.yaml
