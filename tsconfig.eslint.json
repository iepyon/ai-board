{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    // include に並ぶ eslint.config.js を project に載せるため（型検査はしない）
    "allowJs": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts", "eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
